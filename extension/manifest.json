{
  "manifest_version": 3,
  "name": "HTML Studio — 直接编辑本地 / 网页 HTML",
  "version": "1.5.0",
  "description": "在任意 html 页面（本地文件或网页）上直接改文字、字体字号、拖动模块、删除某一页，也能划词批注；Cmd+S 保存成本地文件（自动备份、可撤销）。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "HTML Studio：开启/关闭编辑",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/format.js",
        "lib/move.js",
        "lib/pages.js",
        "lib/annotator.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "在当前页面开启/关闭 HTML Studio 编辑"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
